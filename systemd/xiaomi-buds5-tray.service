[Unit]
Description=Xiaomi Buds 5 tray control
After=graphical-session.target xiaomi-buds5-panel.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=GDK_BACKEND=x11
ExecStart=%h/.local/bin/xiaomi-buds5-tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
